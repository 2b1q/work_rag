COMPOSE_PROJECT_NAME=work-rag

POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

OPENWEBUI_DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

CHROMA_BIND_PORT=8000
# Both take an optional interface. A bare port publishes on EVERY interface:
# WEBUI_BIND_PORT=3000 answers on the machine's LAN address, not just loopback.
# Use 127.0.0.1:3000 unless the UI is meant to be reachable from other machines.
WEBUI_BIND_PORT=3000

OPENWEBUI_ENABLE_PERSISTENT_CONFIG=True
# WEB UI settings
# Fixed signing key. Without it OpenWebUI generates a new one on every restart
# and every session is logged out. Generate with: openssl rand -hex 32
WEBUI_SECRET_KEY=

WEBUI_URL=http://localhost:3000
WEBUI_ADMIN_EMAIL=
WEBUI_ADMIN_PASSWORD=
WEBUI_ADMIN_NAME=

UPSTREAM_OPENAI_API_KEY=
UPSTREAM_OPENAI_BASE_URL=https://api.openai.com/v1

# MCP -> openwebui knowledge graph sync settings
# The sk-... key from Settings -> Account, not the JWT shown above it: the JWT
# expires in four weeks and takes the integration down with it.
OPENWEBUI_API_KEY=
# Optional. An id or a name; the tools fall back to it when a call omits one.
OPENWEBUI_DEFAULT_COLLECTION=

# Directories upload_document_from_path may read, colon-separated, as seen from
# inside the MCP container (mount them in docker-compose.yaml first). Empty
# means path uploads are refused, which is the default.
OPENWEBUI_UPLOAD_ROOTS=

# Largest file upload_document_from_path will read, in bytes. Default 32 MiB.
OPENWEBUI_UPLOAD_MAX_BYTES=

# How long a replace keeps working after the caller has gone, waiting for the new
# version to embed before it removes the old one. Default 15 minutes.
OPENWEBUI_REPLACE_DEADLINE_MS=

# Similarity floor for search_knowledge, 0..1. Belongs to the corpus, not to the
# stack: score a batch of relevant queries and a batch of unrelated ones against
# one collection and put the floor in the gap between the two bands. Conversational
# or distilled text scores lower than curated prose, so a floor carried across that
# boundary returns nothing and looks like a broken pipeline. Default 0.76.
OPENWEBUI_MIN_SCORE=

# How long the MCP server waits on one OpenWebUI request. Default 20 s.
OPENWEBUI_TIMEOUT_MS=

# How long an upload with wait:true watches the embedding queue. Default 45 s,
# because an MCP call over a bridge is cut at about 60.
OPENWEBUI_UPLOAD_SETTLE_MS=

# Browser origins allowed to POST to /mcp, comma-separated. Empty refuses every
# request carrying an Origin header, which is what you want: an MCP client sends
# none, and a browser page cannot then reach this port on the user's behalf.
MCP_ALLOWED_ORIGINS=

# 1 logs each incoming MCP method. Tool failures are logged either way.
MCP_DEBUG=
